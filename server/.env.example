# Copy this file to .env. Never commit .env.
PORT=5002
CLIENT_URL=http://localhost:5173
# Any long random text (keeps users logged in across restarts)
JWT_SECRET=change_me_to_a_long_random_string

# --- Free AI try-on (works with no key) ---------------------------------
# Tops and jackets are tried on by IDM-VTON, an open-source model on a free
# Hugging Face Space. Optional: a free token from https://huggingface.co/settings/tokens
# gives a bigger daily GPU quota.
HF_TOKEN=
# Set to off to disable the free try-on
FREE_TRYON=on

# --- Gemini (optional) ---------------------------------------------------
# Free key from https://aistudio.google.com -> "Get API key".
# A free key powers AI clothes tagging, style analysis and stylist notes.
# Gemini image try-on (all clothing types) needs billing turned on for the key;
# without billing StyleTwin falls back to the free try-on automatically.
GEMINI_API_KEY=
GEMINI_TRYON=on
# Optional: change models if Google renames them
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
